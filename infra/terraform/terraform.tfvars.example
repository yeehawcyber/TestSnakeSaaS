aws_region             = "us-east-1"
environment            = "dev"
project_name           = "testsnakesaas"
image_tag               = "0000000000000000000000000000000000000000"
cognito_domain_prefix  = "testsnakesaas-dev-123456789012"

# Use localhost for the first apply. Replace it with the application_url output
# and apply again so Cognito redirects back to the deployed app.
application_callback_url = "http://localhost:3000"

# Optional but strongly recommended for the USD 10 account-wide monthly budget.
budget_alert_email = null
