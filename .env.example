# Cognito hosted sign-in. These values are public configuration, not secrets.
COGNITO_DOMAIN=https://your-domain-prefix.auth.us-east-1.amazoncognito.com
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=exampleclientid
COGNITO_REDIRECT_URI=http://localhost:3000/
COGNITO_LOGOUT_URI=http://localhost:3000/

# Bedrock runs only on the server and uses the AWS SDK default credential chain.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Optional production guardrail. Set both values or leave both unset.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
