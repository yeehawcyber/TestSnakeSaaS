{
  "family": "snake-shift-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "<ECS_TASK_ROLE_ARN_FROM_AWS_SERVICES_STACK>",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "snake-shift-web",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/snake-shift-web:<IMAGE_TAG>",
      "essential": true,
      "readonlyRootFilesystem": true,
      "user": "1000",
      "portMappings": [
        {
          "name": "http",
          "containerPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "8080"
        },
        {
          "name": "AWS_REGION",
          "value": "<AWS_REGION>"
        },
        {
          "name": "COGNITO_DOMAIN",
          "value": "<COGNITO_DOMAIN_URL>"
        },
        {
          "name": "COGNITO_USER_POOL_ID",
          "value": "<COGNITO_USER_POOL_ID>"
        },
        {
          "name": "COGNITO_CLIENT_ID",
          "value": "<COGNITO_CLIENT_ID>"
        },
        {
          "name": "COGNITO_REDIRECT_URI",
          "value": "<PUBLIC_APP_URL>"
        },
        {
          "name": "COGNITO_LOGOUT_URI",
          "value": "<PUBLIC_APP_URL>"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "us.amazon.nova-lite-v1:0"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:8080/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "stopTimeout": 30,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/snake-shift-web",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "web",
          "mode": "blocking"
        }
      }
    }
  ]
}
